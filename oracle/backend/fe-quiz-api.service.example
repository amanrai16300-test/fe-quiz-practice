# systemd unit for the FE Quiz FastAPI backend.
# Install: copy to /etc/systemd/system/fe-quiz-api.service (see deploy_notes.md).
# Bound to 127.0.0.1:8010 only — not public yet (no nginx).

[Unit]
Description=FE Quiz FastAPI backend
After=network.target postgresql.service

[Service]
User=ubuntu
WorkingDirectory=/opt/fe-quiz-api
EnvironmentFile=/etc/fe-quiz-api.env
ExecStart=/opt/fe-quiz-api/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8010
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
